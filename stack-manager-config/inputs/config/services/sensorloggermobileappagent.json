{
    "ServiceSpec": {
        "Name": "sensorloggermobileappagent",
        "TaskTemplate": {
            "ContainerSpec": {
                "Image": "ghcr.io/theworldavatar/sensorloggermobileappagent:6.1.0",
                "Env": [
                    "KEYCLOAK_SERVER=",
                    "KEYCLOAK_REALM="
                ],
                "Configs": [
                    {
                        "ConfigName": "blazegraph"
                    },
                    {
                        "ConfigName": "postgis"
                    },
                    {
                        "ConfigName": "geoserver"
                    }
                ],
                "Secrets": [
                    {
                        "SecretName": "postgis_password"
                    },
                    {
                        "SecretName": "geoserver_password"
                    }
                ]
            }
        },
        "EndpointSpec": {
            "Ports": [
                {
                    "Name": "web",
                    "Protocol": "tcp",
                    "TargetPort": "5005",
                    "PublishedPort": "5005"
                }
            ]
        }
    },
    "endpoints": {
        "isochroneagent": {
            "url": "http://localhost:8080/SensorLoggerMobileAppAgent/",
            "externalPath": "/sensorloggermobileappagent/"
        }
    }
}